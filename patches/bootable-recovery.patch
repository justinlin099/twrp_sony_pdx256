+static void WriteCrashAddress(const char* label, size_t label_size, uintptr_t value) {
+	constexpr char digits[] = "0123456789abcdef";
+	char line[2 * sizeof(value) + 1];
+	for (size_t index = sizeof(line) - 1; index > 0; --index) {
+		line[index - 1] = digits[value & 0xf];
+		value >>= 4;
+	}
+	line[sizeof(line) - 1] = '\n';
+	write(STDERR_FILENO, label, label_size);
+	write(STDERR_FILENO, line, sizeof(line));
+}
+
+static void TraceDisplayCrash(int signal_number, siginfo_t*, void* context) {
+	const auto& machine = static_cast<const ucontext_t*>(context)->uc_mcontext;
+	constexpr char pc[] = "TWRP crash pc=0x";
+	constexpr char lr[] = "TWRP crash lr=0x";
+	WriteCrashAddress(pc, sizeof(pc) - 1, machine.pc);
+	WriteCrashAddress(lr, sizeof(lr) - 1, machine.regs[30]);
+	_exit(128 + signal_number);
+}
+
+static void EnableDisplayCrashTrace() {
+	dl_iterate_phdr(LogDisplayModule, nullptr);
+	struct sigaction handler = {};
+	handler.sa_sigaction = TraceDisplayCrash;
+	handler.sa_flags = SA_SIGINFO;
+	sigemptyset(&handler.sa_mask);
+	sigaction(SIGSEGV, &handler, nullptr);
+	sigaction(SIGBUS, &handler, nullptr);
+}
