+static constexpr char kSonyMicroSdHost[] =
+    "/sys/devices/platform/soc/8804000.sdhci/mmc_host/mmc1";
+
+struct SonyMicroSdNode {
+	std::string sysfs;
+	std::string device;
+	bool partition;
+};
+
+static bool ParseSonyMicroSdNode(const std::string& sysfs, const std::string& name,
+                                 SonyMicroSdNode* node, std::string* card) {
+	const std::string prefix = std::string(kSonyMicroSdHost) + "/mmc1:";
+	if (sysfs.compare(0, prefix.size(), prefix) != 0)
+		return false;
+
+	const auto block = sysfs.find("/block/mmcblk", prefix.size());
+	if (block == std::string::npos || block == prefix.size() ||
+	    sysfs.find('/', prefix.size()) != block ||
+	    sysfs.find_first_not_of("0123456789abcdef", prefix.size()) != block)
+		return false;
+	const auto disk_start = block + sizeof("/block/") - 1;
+	const auto child = sysfs.find('/', disk_start);
+	const auto disk = sysfs.substr(disk_start, child == std::string::npos
+	                                           ? std::string::npos : child - disk_start);
+	const size_t disk_number = sizeof("mmcblk") - 1;
+	if (disk.size() <= disk_number ||
+	    disk.find_first_not_of("0123456789", disk_number) != std::string::npos)
+		return false;
+
+	const bool partition = child != std::string::npos;
+	const auto leaf = partition ? sysfs.substr(child + 1) : disk;
+	if (name != leaf)
+		return false;
+	if (partition) {
+		const auto partition_prefix = disk + "p";
+		if (leaf.compare(0, partition_prefix.size(), partition_prefix) != 0 ||
+		    leaf.size() <= partition_prefix.size() || leaf[partition_prefix.size()] == '0' ||
+		    leaf.find_first_not_of("0123456789", partition_prefix.size()) != std::string::npos)
+			return false;
+	}
+	*card = sysfs.substr(0, block);
+	*node = {sysfs, "/dev/block/" + name, partition};
+	return true;
+}
+
+static std::string SonyPortableFileSystem(const SonyMicroSdNode& node) {
+	std::string id;
+	struct stat info {};
+	if (lstat(node.device.c_str(), &info) != 0 || !S_ISBLK(info.st_mode) ||
+	    !android::base::ReadFileToString(node.sysfs + "/dev", &id) ||
+	    android::base::Trim(id) != std::to_string(major(info.st_rdev)) + ":" +
+	                              std::to_string(minor(info.st_rdev))) {
+		printf("Sony microSD: device node could not be verified\n");
+		return {};
+	}
+
+	blkid_probe probe = blkid_new_probe_from_filename(node.device.c_str());
+	if (!probe) {
+		printf("Sony microSD: block probe unavailable errno=%d\n", errno);
+		return {};
+	}
+	const char* type = nullptr;
+	std::string filesystem;
+	if (blkid_do_safeprobe(probe) == 0 &&
+	    blkid_probe_lookup_value(probe, "TYPE", &type, nullptr) == 0 && type &&
+	    (strcmp(type, "vfat") == 0 || strcmp(type, "exfat") == 0))
+		filesystem = type;
+	blkid_free_probe(probe);
+	return filesystem;
+}
