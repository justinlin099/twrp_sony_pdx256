+bool TWPartitionManager::Adopt_Decrypted_Data(const string& Block_Device) {
+    // The caller must have verified the user's CE key and retained the FBE policies.
+    // Adopt vold's verified mount without unmounting installed FBE keys.
+    TWPartition* previous = Find_Partition_By_Path("/data");
+    if ((previous && (!previous->Sony_FBE_Adopted || previous->Is_Decrypted)) ||
+        Block_Device.find("/dev/block/") != 0)
+        return false;
+    struct stat block {}, data {};
+    struct statvfs info {};
+    constexpr unsigned long required = ST_NOSUID | ST_NODEV;
+    if (stat(Block_Device.c_str(), &block) != 0 || !S_ISBLK(block.st_mode) ||
+        stat("/data", &data) != 0 || !S_ISDIR(data.st_mode) || data.st_dev != block.st_rdev ||
+        statvfs("/data", &info) != 0 || !info.f_blocks || (info.f_flag & required) != required || (info.f_flag & ST_RDONLY))
+        return false;
+    auto volume = std::make_unique<TWPartition>();
+    const string fstab = "/data f2fs " + Block_Device +
+        " flags=backup=1;ignoreblkid;fsflags=rw,nosuid,nodev,inlinecrypt";
+    if (!volume->Process_Fstab_Line(fstab.c_str(), false, nullptr) || !volume->Is_Mounted())
+        return false;
+    volume->Primary_Block_Device = "/dev/block/by-name/userdata";
+    volume->Decrypted_Block_Device = Block_Device;
+    volume->Key_Directory = "/metadata/vold/metadata_encryption";
+    volume->Is_FBE = true;
+    volume->Is_Encrypted = true;
+    volume->Is_Decrypted = true;
+    volume->Change_Mount_Read_Only(false);
+    const string old_internal_path = DataManager::GetStrValue(TW_INTERNAL_PATH);
+    const string old_has_internal = DataManager::GetStrValue("tw_has_internal");
+    const string old_has_data_media = DataManager::GetStrValue("tw_has_data_media");
+    const auto restore_storage_state = [&]() {
+        DataManager::SetValue(TW_INTERNAL_PATH, old_internal_path);
+        DataManager::SetValue("tw_has_internal", old_has_internal);
+        DataManager::SetValue("tw_has_data_media", old_has_data_media);
+    };
+    volume->Setup_Data_Media(true);
+    volume->Setup_FBE_Exclusions();
+    if (!volume->Is_Mounted() || !volume->Update_Size(false)) {
+        restore_storage_state();
+        return false;
+    }
+    // vold already mounted Data, so Mount() returns before its native bind step.
+    // Complete that step after Setup_Data_Media selected the user's media path.
+    if (!volume->Bind_Mount(false)) {
+        restore_storage_state();
+        LOGERR("Unable to bind decrypted internal storage\n");
+        return false;
+    }
+    struct stat media_source {}, media_target {};
+    const bool media_bound =
+        stat(volume->Symlink_Path.c_str(), &media_source) == 0 &&
+        stat(volume->Symlink_Mount_Point.c_str(), &media_target) == 0 &&
+        S_ISDIR(media_source.st_mode) && S_ISDIR(media_target.st_mode) &&
+        media_source.st_dev == media_target.st_dev &&
+        media_source.st_ino == media_target.st_ino;
+    if (!media_bound) {
+        umount(volume->Symlink_Mount_Point.c_str());
+        restore_storage_state();
+        LOGERR("Internal storage bind verification failed\n");
+        return false;
+    }
+    LOGINFO("Native Data: media bind source and destination verified\n");
+    // Commit only after mount, size and media binding have all succeeded.
+    // Keep the locked placeholder on every failure so the native Mount page
+    // can offer another credential attempt without exposing ciphertext.
+    volume->Sony_FBE_Adopted = true;
+    if (previous) {
+        volume->MTP_Storage_ID = previous->MTP_Storage_ID;
+        auto slot = std::find(Partitions.begin(), Partitions.end(), previous);
+        if (slot == Partitions.end()) {
+            umount(volume->Symlink_Mount_Point.c_str());
+            restore_storage_state();
+            return false;
+        }
+        *slot = volume.release();
+        delete previous;
+    } else {
+        Add_Partition(volume.release());
+    }
+    Setup_MTP_Storage_IDs();
+    Output_Partition(Find_Partition_By_Path("/data"));
+    // Late FBE handoff must establish the same emulated-storage state as
+    // Setup_Fstab_Partitions, before native translated names are refreshed.
+    datamedia = true;
+    DataManager::SetValue(TW_IS_DECRYPTED, 1);
+    DataManager::SetValue(TW_IS_FBE, 1);
+    DataManager::SetValue(TW_IS_ENCRYPTED, 0);
+    // Match Post_Decrypt: ReadSettingsFile uses this native persistent path.
+    DataManager::SetValue("tw_settings_path", TW_STORAGE_PATH);
+    Add_MTP_Storage("/data");
+    LOGINFO("Native Data: adopted vold FBE mount with native backup exclusions\n");
+    return true;
+}
+
+bool TWPartitionManager::Add_Probed_Storage(const string& Fstab_Line, bool Writable) {
+	auto volume = std::make_unique<TWPartition>();
+	if (!volume->Process_Fstab_Line(Fstab_Line.c_str(), false, nullptr) ||
+	    !volume->Is_Present || !volume->Is_Storage)
+		return false;
+
+	volume->Change_Mount_Read_Only(true);
+	const bool mounted = volume->Mount(false);
+	struct statvfs info {};
+	constexpr unsigned long required = ST_RDONLY | ST_NOSUID | ST_NODEV | ST_NOEXEC;
+	const bool verified = mounted && statvfs(volume->Mount_Point.c_str(), &info) == 0 &&
+	                      (info.f_flag & required) == required && info.f_blocks != 0 &&
+	                      volume->Update_Size(false);
+	if (mounted && !volume->UnMount(false)) {
+		umount2(volume->Mount_Point.c_str(), MNT_DETACH);
+		return false;
+	}
+	if (!verified)
+		return false;
+
+	volume->Change_Mount_Read_Only(!Writable);
+	Add_Partition(volume.release());
+	return true;
+}
