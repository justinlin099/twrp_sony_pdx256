+static void LogSonyFbeProbeDiagnostics() {
+	std::ifstream mounts("/proc/self/mounts");
+	for (std::string mount; std::getline(mounts, mount);) {
+		if (mount.find(" /vendor ") != std::string::npos ||
+		    mount.find(" /vendor/firmware_mnt ") != std::string::npos) {
+			printf("Sony FBE mount: %s\n", mount.c_str());
+		}
+	}
+
+	const char* const targets[] = {
+		"/system/bin/xperia_recovery_service_trace",
+		"/system/bin/linker64",
+		"/vendor/bin/qseecomd",
+		"/vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service",
+		"/vendor/bin/hw/android.hardware.security.keymint-service-qti",
+		"/vendor/bin/hw/android.hardware.gatekeeper-service-qti",
+	};
+	for (const char* target : targets) {
+		struct stat info {};
+		const int result = stat(target, &info);
+		const std::string status = result < 0 ? strerror(errno) : std::to_string(info.st_mode);
+		char* context = nullptr;
+		const int label_result = getfilecon(target, &context);
+		printf("Sony FBE executable: %s stat=%s label=%s\n", target, status.c_str(),
+		       label_result < 0 ? strerror(errno) : context);
+		freecon(context);
+	}
+
+	const int buffer_size = klogctl(10, nullptr, 0); // SYSLOG_ACTION_SIZE_BUFFER
+	const int max_log_size = 16 * 1024 * 1024;
+	const int log_size = buffer_size > 0 ? std::min(buffer_size, max_log_size) : 512 * 1024;
+	std::vector<char> log(log_size);
+	const int bytes = klogctl(3, log.data(), log.size()); // SYSLOG_ACTION_READ_ALL
+	if (bytes < 0) {
+		printf("Sony FBE kernel log unavailable: %s\n", strerror(errno));
+		return;
+	}
+	printf("Sony FBE kernel log bytes=%d buffer_size=%d\n", bytes, buffer_size);
+	std::string_view remaining(log.data(), bytes);
+	size_t init_lines = 0;
+	size_t probe_lines = 0;
+	while (!remaining.empty()) {
+		const size_t newline = remaining.find('\n');
+		const auto line = remaining.substr(0, newline);
+		const bool init_line = line.find("init: ") != std::string_view::npos;
+		const bool probe_line =
+			line.find("xperia_") != std::string_view::npos ||
+			line.find("xperia.fbe_probe") != std::string_view::npos ||
+			line.find("xperia-service.log") != std::string_view::npos ||
+			line.find("createProcessGroup") != std::string_view::npos ||
+			line.find("cannot setexeccon") != std::string_view::npos ||
+			line.find("/vendor/firmware_mnt") != std::string_view::npos ||
+			(line.find("avc: denied") != std::string_view::npos &&
+			 (line.find("vendor_hal_keymint") != std::string_view::npos ||
+			  line.find("vendor_hal_gatekeeper") != std::string_view::npos ||
+			  line.find("qsee") != std::string_view::npos ||
+			  line.find("scontext=u:r:init:s0") != std::string_view::npos));
+		if (probe_line && probe_lines++ < 80) {
+			printf("Sony FBE kernel: %.*s\n", static_cast<int>(line.size()), line.data());
+		} else if (init_line && init_lines++ < 4) {
+			printf("Sony FBE kernel init sample: %.*s\n", static_cast<int>(line.size()), line.data());
+		}
+		if (newline == std::string_view::npos)
+			break;
+		remaining.remove_prefix(newline + 1);
+	}
+	printf("Sony FBE kernel counts: init=%zu probe=%zu\n", init_lines, probe_lines);
+}
