+static void ProbeSonyFbeServices() {
+	if (access("/tmp/xperia-fbe-startup-failed", F_OK) == 0) {
+		printf("Sony FBE disabled after startup failure\n");
+		return;
+	}
+	if (access("/xperia_fbe_hal_probe", F_OK) != 0)
+		return;
+	const bool storage_status = access("/xperia_ce_local_ui", F_OK) == 0;
+	if (storage_status)
+		InitSonyStorageStatus();
+	if (PartitionManager.Find_Partition_By_Path("/data")) {
+		printf("Sony FBE probe requires a build without a userdata fstab entry\n");
+		return;
+	}
+	if (!PartitionManager.Mount_By_Path("/vendor", false)) {
+		printf("Sony FBE probe could not mount the read-only vendor partition\n");
+		return;
+	}
+	struct statvfs vendor {};
+	if (storage_status && statvfs("/vendor", &vendor) == 0 && (vendor.f_flag & ST_RDONLY))
+		DataManager::SetValue("tw_xperia_storage_vendor", "Read-only mount verified");
+	const bool services_started = property_get_bool("sys.xperia.fbe_probe", false);
+	if (!services_started && property_set("sys.xperia.fbe_probe", "1") != 0) {
+		printf("Sony FBE probe could not trigger security services\n");
+		return;
+	}
+
+	struct ProbeService {
+		const char* binder_name;
+		const char* init_state;
+		bool registered = false;
+	};
+	const auto probe = [](std::vector<ProbeService> services, int attempts) {
+		bool all_registered = false;
+		for (int attempt = 0; attempt < attempts; ++attempt) {
+			all_registered = true;
+			for (auto& service : services) {
+				::ndk::SpAIBinder binder(AServiceManager_checkService(service.binder_name));
+				service.registered = binder.get() != nullptr;
+				all_registered &= service.registered;
+			}
+			if (all_registered)
+				break;
+			std::this_thread::sleep_for(std::chrono::milliseconds(500));
+		}
+		for (const auto& service : services) {
+			char state[PROPERTY_VALUE_MAX];
+			property_get(service.init_state, state, "unset");
+			printf("Sony FBE probe %s: %s, init=%s\n", service.binder_name,
+			       service.registered ? "registered" : "unavailable", state);
+		}
+		return all_registered;
+	};
+	const bool hal_ready = probe({
+		{"vendor.qti.hardware.qseecom.IQSEECom/default", "init.svc.xperia_qsee_hal"},
+		{"android.hardware.security.keymint.IKeyMintDevice/default", "init.svc.xperia_keymint"},
+		{"android.hardware.gatekeeper.IGatekeeper/default", "init.svc.xperia_gatekeeper"},
+	}, 10);
+	if (services_started || access("/xperia_fbe_keystore_probe", F_OK) == 0) {
+		if (hal_ready && (services_started || property_set("sys.xperia.keystore_probe", "1") == 0)) {
+			const bool keystore_ready = probe({
+				{"android.system.keystore2.IKeystoreService/default", "init.svc.xperia_keystore2"},
+				{"android.security.authorization", "init.svc.xperia_keystore2"},
+			}, 30);
+			if (services_started && keystore_ready) {
+				if (access("/xperia_ce_local_ui", F_OK) == 0) {
+					SonyCeProbe ce;
+					if (MountSonyEncryptedData(&ce)) {
+						sony_ce_credential_type = ce.credential_type;
+						// Native Mount -> Decrypt Data selects the per-user credential type.
+						DataManager::SetValue("tw_crypto_pwtype_0", sony_ce_credential_type);
+						DataManager::SetValue("tw_xperia_storage_data", "F2FS detected - user 0 locked");
+					}
+				} else {
+					MountSonyEncryptedData();
+				}
+			}
+		} else {
+			printf("Sony FBE probe could not start Keystore2 after the HALs\n");
+		}
+	}
+	if (services_started)
+		ProbeSonyMicroSd();
+	ExportSonyStockKeystore();
+	LogSonyFbeProbeDiagnostics();
+}
+#endif
