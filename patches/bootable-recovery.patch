+void TWPartitionManager::Setup_MTP_Storage_IDs() {
+	// Native fstab ID scheme, also used before a new MTP session so storage
+	// discovered after initial fstab processing participates in that session.
+	unsigned int storageid = 1 << 16;
+	for (auto* part : Partitions) {
+        // Keep the slot reserved while adopted Data is locked, so toggling
+        // MTP cannot renumber a removable card that is already registered.
+		if (part->Is_Storage || part->Sony_FBE_Adopted)
+			part->MTP_Storage_ID = ++storageid;
+	}
+}
