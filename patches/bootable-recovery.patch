+// Match AOSP recovery: do not start a new USB configuration until init
+// acknowledges the preceding transition. Bound the wait so the UI can report errors.
+static bool SetRecoveryUsbConfig(const char* config) {
+	if (!android::base::SetProperty("sys.usb.config", config) ||
+	    !android::base::WaitForProperty("sys.usb.state", config, std::chrono::seconds(5))) {
+		LOGERR("USB configuration transition failed: requested=%s observed=%s\n",
+		       config, android::base::GetProperty("sys.usb.state", "").c_str());
+		return false;
+	}
+	return true;
+}
