+
+// Device-owned icon: never read shared storage or accept a host-selected path.
+static bool ReadMtpDeviceIcon(std::vector<uint8_t>& bytes) {
+  // Sony pdx256 stock framework overlay: 186 black, 187 green, 188 purple.
+  // Only fixed bundled paths; never interpret another model's color numbering.
+  const char* icon_path = "/twres/device.ico";
+  if (android::base::GetProperty("ro.product.device", "") == "pdx256") {
+    const auto color = android::base::GetProperty("ro.boot.hardware.color", "");
+    if (color == "187") icon_path = "/twres/device-pdx256-187.ico";
+    else if (color == "188") icon_path = "/twres/device-pdx256-188.ico";
+    // 186 and unrecognized values retain the original black/default icon.
+  }
+  std::ifstream input(icon_path, std::ios::binary | std::ios::ate);
+  if (!input) {
+    input.clear();
+    input.open("/twres/device.ico", std::ios::binary | std::ios::ate);
+  }
+  if (!input) return false;
+  const auto size = input.tellg();
+  if (size < 6 || size > 262144) return false;
+  bytes.resize(static_cast<size_t>(size));
+  input.seekg(0);
+  if (!input.read(reinterpret_cast<char*>(bytes.data()), bytes.size())) return false;
+  return bytes[0] == 0 && bytes[1] == 0 && bytes[2] == 1 && bytes[3] == 0 &&
+      (bytes[4] != 0 || bytes[5] != 0);
+}
