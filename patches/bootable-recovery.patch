diff --git a/bounded-load-sample.hpp b/bounded-load-sample.hpp
new file mode 100755
index 0000000..5ecd192
--- /dev/null
+++ b/bounded-load-sample.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <cstdio>
+#include <time.h>
+#include <unistd.h>
+#include "thermal-load-snapshot.hpp"
+
+// Called by the existing one-second battery monitor, only in diagnostic images.
+// Process CPU clocks avoid /proc permissions and do not inspect user data.
+inline void SampleRecoveryCpuBounded() {
+    static const bool enabled = access("/xperia_load_probe", F_OK) == 0;
+    static unsigned samples = 0;
+    static double last_wall = 0, last_cpu = 0;
+    if (!enabled || samples >= 6) return;
+    timespec wall{}, cpu{};
+    if (clock_gettime(CLOCK_MONOTONIC, &wall) != 0 ||
+        clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &cpu) != 0) return;
+    const double now = wall.tv_sec + wall.tv_nsec / 1e9;
+    const double used = cpu.tv_sec + cpu.tv_nsec / 1e9;
+    if (last_wall == 0) {
+        last_wall = now;
+        last_cpu = used;
+        SnapshotXperiaThermalLoad();
+        return;
+    }
+    if (now - last_wall < 10) return;
+    std::printf("Xperia CPU sample: elapsed=%.3f cpu=%.3f percent_one_core=%.2f\n",
+                now - last_wall, used - last_cpu,
+                100 * (used - last_cpu) / (now - last_wall));
+    SnapshotXperiaThermalLoad();
+    last_wall = now;
+    last_cpu = used;
+    ++samples;
+}
diff --git a/data-scan-avc-summary.hpp b/data-scan-avc-summary.hpp
new file mode 100644
index 0000000..97db004
--- /dev/null
+++ b/data-scan-avc-summary.hpp
@@ -0,0 +1,38 @@
+#pragma once
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Keep policy fields only; filenames and application paths are not diagnostic output.
+static std::vector<std::string> XperiaDataScanAvcSummary(std::string_view log) {
+    std::set<std::string> seen;
+    std::vector<std::string> result;
+    while (!log.empty()) {
+        const auto end = log.find('\n');
+        const auto line = log.substr(0, end);
+        const auto avc = line.find("avc:");
+        const auto denied = line.find("denied", avc);
+        const auto source = line.find("scontext=u:r:recovery:s0");
+        if (avc != std::string_view::npos && denied != std::string_view::npos &&
+            source != std::string_view::npos) {
+            const auto open = line.find('{', denied);
+            const auto close = line.find('}', open);
+            auto field = [&](std::string_view name) -> std::string {
+                const auto start = line.find(name);
+                if (start == std::string_view::npos) return {};
+                return std::string(line.substr(start, line.find_first_of(" \r", start) - start));
+            };
+            const auto target = field("tcontext=");
+            const auto type = field("tclass=");
+            if (open != std::string_view::npos && close != std::string_view::npos &&
+                !target.empty() && !type.empty()) {
+                const auto item = std::string(line.substr(open, close-open+1)) + " " + target + " " + type;
+                if (seen.insert(item).second && result.size() < 64) result.push_back(item);
+            }
+        }
+        if (end == std::string_view::npos) break;
+        log.remove_prefix(end+1);
+    }
+    return result;
+}
diff --git a/named-thermal-sensor.hpp b/named-thermal-sensor.hpp
new file mode 100644
index 0000000..6dd87e6
--- /dev/null
+++ b/named-thermal-sensor.hpp
@@ -0,0 +1,25 @@
+#pragma once
+#include <dirent.h>
+#include <fstream>
+#include <string>
+
+// Match the kernel sensor name rather than a boot-dependent thermal zone number.
+inline std::string FindNamedThermalSensor(const std::string& root, const std::string& name) {
+    DIR* directory = opendir(root.c_str());
+    if (!directory) return {};
+    std::string result;
+    while (auto* entry = readdir(directory)) {
+        const std::string zone(entry->d_name);
+        if (zone.compare(0, 12, "thermal_zone") != 0) continue;
+        const auto path = root + "/" + zone;
+        std::ifstream type(path + "/type");
+        std::string sensor;
+        if (std::getline(type, sensor) && sensor == name) {
+            std::ifstream temperature(path + "/temp");
+            if (temperature.good()) result = path + "/temp";
+            break;
+        }
+    }
+    closedir(directory);
+    return result;
+}
diff --git a/thermal-load-snapshot.hpp b/thermal-load-snapshot.hpp
new file mode 100755
index 0000000..67e847e
--- /dev/null
+++ b/thermal-load-snapshot.hpp
@@ -0,0 +1,80 @@
+#pragma once
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <dirent.h>
+#include <string>
+
+// Read only fixed kernel telemetry files. Never inspect application data.
+inline std::string XperiaTelemetryRead(const std::string& path) {
+    FILE* file = std::fopen(path.c_str(), "r");
+    if (!file) return "unavailable(errno=" + std::to_string(errno) + ")";
+    char line[512];
+    const bool ok = std::fgets(line, sizeof(line), file) != nullptr;
+    const int error = errno;
+    std::fclose(file);
+    if (!ok) return "unavailable(read,errno=" + std::to_string(error) + ")";
+    line[std::strcspn(line, "\r\n")] = 0;
+    return line;
+}
+
+inline void SnapshotXperiaThermalLoad(const std::string& root = "") {
+    std::printf("Xperia system CPU counters: %s\n",
+                XperiaTelemetryRead(root + "/proc/stat").c_str());
+    const std::string cpu = root + "/sys/devices/system/cpu/cpufreq";
+    DIR* directory = opendir(cpu.c_str());
+    if (!directory) std::printf("Xperia cpufreq: unavailable errno=%d\n", errno);
+    if (directory) {
+        unsigned count = 0;
+        while (auto* entry = readdir(directory)) {
+            const std::string name(entry->d_name);
+            if (name.compare(0, 6, "policy") != 0 || count >= 16) continue;
+            ++count;
+            const auto path = cpu + "/" + name;
+            std::printf("Xperia cpufreq %s: current_kHz=%s min_kHz=%s max_kHz=%s governor=%s\n",
+                name.c_str(), XperiaTelemetryRead(path + "/scaling_cur_freq").c_str(),
+                XperiaTelemetryRead(path + "/scaling_min_freq").c_str(),
+                XperiaTelemetryRead(path + "/scaling_max_freq").c_str(),
+                XperiaTelemetryRead(path + "/scaling_governor").c_str());
+        }
+        closedir(directory);
+    }
+    const std::string thermal = root + "/sys/class/thermal";
+    directory = opendir(thermal.c_str());
+    if (!directory) std::printf("Xperia thermal: unavailable errno=%d\n", errno);
+    if (directory) {
+        unsigned count = 0;
+        while (auto* entry = readdir(directory)) {
+            const std::string name(entry->d_name);
+            if (name.compare(0, 12, "thermal_zone") != 0 || count >= 128) continue;
+            ++count;
+            const auto path = thermal + "/" + name;
+            const auto type = XperiaTelemetryRead(path + "/type");
+            if (type.find("cpuss") == std::string::npos && type.find("skin") == std::string::npos &&
+                type.find("battery") == std::string::npos && type.find("unavailable") == std::string::npos) continue;
+            std::printf("Xperia thermal %s: type=%s millidegrees=%s\n", name.c_str(),
+                type.c_str(), XperiaTelemetryRead(path + "/temp").c_str());
+        }
+        closedir(directory);
+    }
+    const std::string power = root + "/sys/class/power_supply";
+    directory = opendir(power.c_str());
+    if (!directory) std::printf("Xperia power_supply: unavailable errno=%d\n", errno);
+    if (directory) {
+        unsigned count = 0;
+        while (auto* entry = readdir(directory)) {
+            const std::string name(entry->d_name);
+            if (name[0] == '.' || count >= 32) continue;
+            ++count;
+            const auto path = power + "/" + name;
+            const auto type = XperiaTelemetryRead(path + "/type");
+            if (type != "Battery") continue;
+            std::printf("Xperia battery %s: temp_tenths_C=%s status=%s current_uA=%s voltage_uV=%s\n",
+                name.c_str(), XperiaTelemetryRead(path + "/temp").c_str(),
+                XperiaTelemetryRead(path + "/status").c_str(),
+                XperiaTelemetryRead(path + "/current_now").c_str(),
+                XperiaTelemetryRead(path + "/voltage_now").c_str());
+        }
+        closedir(directory);
+    }
+}
diff --git a/thermal-value.hpp b/thermal-value.hpp
new file mode 100755
index 0000000..3021ab4
--- /dev/null
+++ b/thermal-value.hpp
@@ -0,0 +1,14 @@
+#pragma once
+#include <sstream>
+#include <string>
+
+// Kernel thermal-zone temperatures are signed millidegrees Celsius.
+inline bool ParseCpuThermalValue(const std::string& text, int& degrees) {
+    std::istringstream input(text);
+    long long milli;
+    if (!(input >> milli)) return false;
+    input >> std::ws;
+    if (!input.eof() || milli < -40000 || milli > 150000) return false;
+    degrees = static_cast<int>(milli / 1000);
+    return true;
+}
