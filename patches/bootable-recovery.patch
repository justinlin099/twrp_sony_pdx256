+
+bool XperiaCheckCeFromGui([[maybe_unused]] std::string& password) {
+#ifdef TW_INCLUDE_CRYPTO
+    bool verified = SonyBrowseKeysPresent();
+    // Do not report success or try to re-create an already owned mapper when
+    // its previous filesystem keyring has disappeared. Re-auth handoff must
+    // explicitly release that mount before a new credential attempt.
+    if (!verified && !sony_browse_policies.empty()) {
+        gui_err("decrypt_keys_missing=Data encryption keys are no longer available. Restart recovery and unlock again.");
+    } else if (!verified && sony_ce_credential_type != 0 && !password.empty()) {
+        SonyCeProbe ce;
+        ce.credential = &password;
+        verified = MountSonyEncryptedData(&ce);
+        if (!verified && ce.protector_unwrapped)
+            gui_err("decrypt_storage_failed=Credential accepted, but Data could not be mounted.");
+    }
+    OPENSSL_cleanse(password.data(), password.size());
+    password.clear();
+    return verified;
+#else
+    return false;
+#endif
+}
