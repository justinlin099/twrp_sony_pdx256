+uint64_t TWExclude::Get_Folder_Size(const string& Path, bool* Complete) {
+    if (Complete) *Complete = true;
+    uint64_t dusize = 0;
+    DIR* directory = opendir(Path.c_str());
+    if (!directory) {
+        if (Complete) *Complete = false;
+        gui_msg(Msg(msg::kError, "error_opening_strerr=Error opening: '{1}' ({2})")(Path)(strerror(errno)));
+        return 0;
+    }
+    for (;;) {
+        errno = 0;
+        struct dirent* entry = readdir(directory);
+        if (!entry) {
+            if (errno) {
+                if (Complete) *Complete = false;
+                LOGERR("Unable to finish directory scan: %s\n", strerror(errno));
+            }
+            break;
+        }
+        const string path = Path + "/" + entry->d_name;
+        // Exclusions apply to both files and directories, before accessing either.
+        if (check_skip_dirs(path)) continue;
+        struct stat info {};
+        if (lstat(path.c_str(), &info) != 0) {
+            if (Complete) *Complete = false;
+            gui_msg(Msg(msg::kError, "error_opening_strerr=Error opening: '{1}' ({2})")(path)(strerror(errno)));
+            continue;
+        }
+        if (S_ISDIR(info.st_mode)) {
+            bool child_complete = true;
+            dusize += Get_Folder_Size(path, &child_complete);
+            if (Complete && !child_complete) *Complete = false;
+        } else if (S_ISREG(info.st_mode) || S_ISLNK(info.st_mode)) {
+            dusize += static_cast<uint64_t>(info.st_size);
+        }
+    }
+    closedir(directory);
+    return dusize;
 }
 
