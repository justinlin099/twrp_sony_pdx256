+static bool InstallSonyProbeKey(const std::string& key_dir, const char* target,
+                                const android::fscrypt::EncryptionOptions& options,
+                                android::fscrypt::EncryptionPolicy* policy) {
+	android::vold::KeyBuffer wrapped_key;
+	android::vold::KeyBuffer ephemeral_key;
+	return android::vold::retrieveKeyWithoutUpgrade(key_dir, android::vold::kEmptyAuthentication,
+	                                              &wrapped_key) &&
+	       android::vold::exportWrappedStorageKeyWithoutUpgrade(wrapped_key, &ephemeral_key) &&
+	       android::vold::installKey(target, options, ephemeral_key, policy);
+}
+
+static void ProbeSonyProtectorHardware(std::vector<uint8_t>& key_blob) {
+	if (key_blob.empty())
+		return;
+
+	namespace km = aidl::android::hardware::security::keymint;
+	constexpr char service[] = "android.hardware.security.keymint.IKeyMintDevice/default";
+	ndk::SpAIBinder binder(AServiceManager_checkService(service));
+	auto keymint = km::IKeyMintDevice::fromBinder(binder);
+	if (!keymint) {
+		OPENSSL_cleanse(key_blob.data(), key_blob.size());
+		printf("Sony CE KeyMint probe: unavailable\n");
+		return;
+	}
+	std::vector<km::KeyCharacteristics> characteristics;
+	const auto status = keymint->getKeyCharacteristics(key_blob, {}, {}, &characteristics);
+	OPENSSL_cleanse(key_blob.data(), key_blob.size());
+
+	bool tee = false;
+	bool secure_user = false;
+	bool auth_timeout = false;
+	bool no_auth = false;
+	if (status.isOk()) {
+		for (const auto& group : characteristics) {
+			tee |= group.securityLevel == km::SecurityLevel::TRUSTED_ENVIRONMENT;
+			for (const auto& authorization : group.authorizations) {
+				secure_user |= authorization.tag == km::Tag::USER_SECURE_ID;
+				auth_timeout |= authorization.tag == km::Tag::AUTH_TIMEOUT;
+				no_auth |= authorization.tag == km::Tag::NO_AUTH_REQUIRED;
+			}
+		}
+	}
+	printf("Sony CE KeyMint probe: ok=%d error=%d tee=%d secure_user=%d auth_timeout=%d no_auth=%d\n",
+	       status.isOk(), status.getServiceSpecificError(), tee, secure_user, auth_timeout, no_auth);
+}
