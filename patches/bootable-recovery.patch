+static void ExportSonyStockKeystore() {
+	if (access("/xperia_stock_keystore_export", F_OK) != 0)
+		return;
+	std::string device;
+	const char* mount_point = "/mnt/xperia-stock-system";
+	if (!android::dm::DeviceMapper::Instance().GetDmDevicePathByName("system_a", &device)) {
+		printf("Sony stock Keystore2: system_a mapping is unavailable\n");
+		return;
+	}
+	if (mount(device.c_str(), mount_point, "ext4", MS_RDONLY | MS_NODEV | MS_NOSUID | MS_NOEXEC,
+	          "noload") < 0) {
+		printf("Sony stock Keystore2: read-only system mount failed: %s\n", strerror(errno));
+		return;
+	}
+
+	const char* const paths[] = {
+		"/mnt/xperia-stock-system/bin/keystore2",
+		"/mnt/xperia-stock-system/system/bin/keystore2",
+	};
+	const char* output = "/tmp/xperia-stock-keystore2";
+	bool exported = false;
+	for (const char* path : paths) {
+		struct stat input {};
+		if (lstat(path, &input) < 0 || !S_ISREG(input.st_mode) ||
+		    input.st_size <= 4 || input.st_size > 16 * 1024 * 1024)
+			continue;
+		char magic[4];
+		std::ifstream stream(path, std::ios::binary);
+		if (!stream.read(magic, sizeof(magic)) || std::memcmp(magic, "\x7f" "ELF", 4) != 0)
+			continue;
+		struct stat result {};
+		exported = TWFunc::copy_file(path, output, 0644, false) == 0 &&
+		           lstat(output, &result) == 0 && result.st_size == input.st_size;
+		break;
+	}
+	printf("Sony stock Keystore2: %s\n", exported ? "read-only export ready" : "stock ELF unavailable");
+	if (umount(mount_point) < 0)
+		printf("Sony stock Keystore2: system unmount failed: %s\n", strerror(errno));
+}
