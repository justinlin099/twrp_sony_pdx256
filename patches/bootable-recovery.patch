+static bool FindSonyMicroSd(std::string* device, std::string* filesystem,
+                            std::string* card_capacity = nullptr) {
+	const bool host = access(kSonyMicroSdHost, F_OK) == 0;
+	printf("Sony microSD: host_visible=%d\n", host);
+	if (!host)
+		return false;
+
+	std::unique_ptr<DIR, decltype(&closedir)> blocks(opendir("/sys/class/block"), closedir);
+	if (!blocks) {
+		printf("Sony microSD: block list unavailable errno=%d\n", errno);
+		return false;
+	}
+	std::vector<SonyMicroSdNode> nodes;
+	bool has_partitions = false;
+	while (const auto* entry = readdir(blocks.get())) {
+		const std::string name(entry->d_name);
+		if (name.compare(0, sizeof("mmcblk") - 1, "mmcblk") != 0)
+			continue;
+		const std::string link = "/sys/class/block/" + name;
+		std::unique_ptr<char, decltype(&free)> sysfs(realpath(link.c_str(), nullptr), free);
+		SonyMicroSdNode node;
+		std::string card;
+		std::string card_type;
+		if (sysfs && ParseSonyMicroSdNode(sysfs.get(), name, &node, &card) &&
+		    android::base::ReadFileToString(card + "/type", &card_type) &&
+		    android::base::Trim(card_type) == "SD") {
+			has_partitions |= node.partition;
+			nodes.push_back(std::move(node));
+		}
+	}
+
+	if (card_capacity) {
+		// The kernel exposes block device sizes in 512-byte sectors, including
+		// on media with a larger logical sector size.
+		size_t disks = 0;
+		uint64_t disk_sectors = 0;
+		for (const auto& node : nodes) {
+			std::string value;
+			uint64_t sectors = 0;
+			if (android::base::ReadFileToString(node.sysfs + "/size", &value) &&
+			    android::base::ParseUint(android::base::Trim(value), &sectors)) {
+				printf("Sony microSD: device=%s sectors_512=%" PRIu64 "\n",
+				       node.device.c_str(), sectors);
+			}
+			if (!node.partition) {
+				++disks;
+				disk_sectors = sectors;
+			}
+		}
+		if (disks == 1 && disk_sectors != 0)
+			*card_capacity = std::to_string(disk_sectors / 2048) + " MiB";
+	}
+
+	size_t portable = 0;
+	for (const auto& node : nodes) {
+		if (has_partitions && !node.partition)
+			continue;
+		const auto detected = SonyPortableFileSystem(node);
+		if (detected.empty())
+			continue;
+		*device = node.device;
+		*filesystem = detected;
+		++portable;
+	}
+	printf("Sony microSD: block_nodes=%zu portable_volumes=%zu\n", nodes.size(), portable);
+	return portable == 1;
+}
+
+static std::string SonyStorageCapacity(const struct statvfs& info) {
+	constexpr unsigned long long mib = 1024 * 1024;
+	const auto free = static_cast<unsigned long long>(info.f_bavail) * info.f_frsize / mib;
+	const auto total = static_cast<unsigned long long>(info.f_blocks) * info.f_frsize / mib;
+	return std::to_string(free) + " MiB free / " + std::to_string(total) + " MiB total";
+}
+
+static void InitSonyStorageStatus() {
+	DataManager::SetValue("tw_xperia_storage_status", 1);
+	DataManager::SetValue("tw_xperia_storage_data", "Not verified");
+	DataManager::SetValue("tw_xperia_storage_data_capacity", "Unavailable until CE verification");
+	DataManager::SetValue("tw_xperia_storage_metadata", "Not verified");
+	DataManager::SetValue("tw_xperia_storage_vendor", "Not verified");
+	DataManager::SetValue("tw_xperia_storage_card_size", "Capacity unavailable");
+	DataManager::SetValue("tw_xperia_storage_card", "No usable portable volume verified");
+	DataManager::SetValue("tw_xperia_storage_card_capacity", "Capacity unavailable");
+	DataManager::SetValue("tw_xperia_storage_slot", PartitionManager.Get_Active_Slot_Display());
+	std::string detected;
+	for (const char* path : {"/boot", "/init_boot", "/vendor_boot", "/recovery", "/dtbo"}) {
+		const auto* partition = PartitionManager.Find_Partition_By_Path(path);
+		struct stat device {};
+		if (!partition || !partition->Is_Present ||
+		    stat(partition->Actual_Block_Device.c_str(), &device) != 0 || !S_ISBLK(device.st_mode))
+			continue;
+		if (!detected.empty())
+			detected += ", ";
+		detected += path + 1;
+	}
+	DataManager::SetValue("tw_xperia_storage_blocks", detected.empty() ? "None verified" : detected);
+}
+
+static std::string sony_verified_sd_device;
+static std::string sony_verified_sd_filesystem;
+constexpr char kSonyNativeSdMount[] = "/external_sd";
+
+static bool ProbeSonyMicroSd() {
+	std::string device;
+	std::string filesystem;
+	std::string card_capacity;
+	const bool show_status = DataManager::GetIntValue("tw_xperia_storage_status") == 1;
+	const bool found = FindSonyMicroSd(&device, &filesystem, show_status ? &card_capacity : nullptr);
+	if (!card_capacity.empty())
+		DataManager::SetValue("tw_xperia_storage_card_size", card_capacity);
+	if (!found)
+		return false;
+
+	char target[] = "/tmp/xperia-microsd.XXXXXX";
+	if (!mkdtemp(target)) {
+		printf("Sony microSD: temporary mountpoint failed errno=%d\n", errno);
+		return false;
+	}
+	constexpr unsigned long flags = MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC;
+	const bool mounted = mount(device.c_str(), target, filesystem.c_str(), flags, nullptr) == 0;
+	const int mount_error = mounted ? 0 : errno;
+	struct statvfs info {};
+	constexpr unsigned long required = ST_RDONLY | ST_NOSUID | ST_NODEV | ST_NOEXEC;
+	const bool verified = mounted && statvfs(target, &info) == 0 &&
+	                      (info.f_flag & required) == required;
+	const auto available = verified
+	    ? static_cast<unsigned long long>(info.f_bavail) * info.f_frsize : 0;
+	const bool unmounted = !mounted || umount(target) == 0;
+	const bool cleaned = unmounted && rmdir(target) == 0;
+	printf("Sony microSD: filesystem=%s mount_errno=%d flags_verified=%d free_bytes=%llu cleaned=%d\n",
+	       filesystem.c_str(), mount_error, verified, available, cleaned);
+	if (verified && cleaned && show_status) {
+		sony_verified_sd_device = device;
+		sony_verified_sd_filesystem = filesystem;
+		const auto name = device.substr(sizeof("/dev/block/") - 1);
+		DataManager::SetValue("tw_xperia_storage_card", "Backup volume: " + name + " (" + filesystem + ")");
+		DataManager::SetValue("tw_xperia_storage_card_capacity", SonyStorageCapacity(info));
+	}
+	return verified && cleaned;
+}
+
+struct SonyCeProbe {
+	std::string* credential = nullptr;
+	int credential_type = 0;
+	bool protector_unwrapped = false;
+	std::string data_capacity;
+	std::vector<android::fscrypt::EncryptionPolicy> retained_policies;
+};
+
+static bool SonyCePolicyMatches(const std::string& path,
+                               const android::fscrypt::EncryptionPolicy& policy) {
+	const int fd = open(path.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0) {
+		printf("Sony CE policy: directory errno=%d\n", errno);
+		return false;
+	}
+	struct fscrypt_get_policy_ex_arg query {};
+	query.policy_size = sizeof(query.policy);
+	const int error = ioctl(fd, FS_IOC_GET_ENCRYPTION_POLICY_EX, &query) == 0 ? 0 : errno;
+	close(fd);
+	const bool matches = error == 0 && query.policy.version == FSCRYPT_POLICY_V2 &&
+	                     query.policy_size == sizeof(query.policy.v2) &&
+	                     policy.key_raw_ref.size() == FSCRYPT_KEY_IDENTIFIER_SIZE &&
+	                     memcmp(policy.key_raw_ref.data(), query.policy.v2.master_key_identifier,
+	                            FSCRYPT_KEY_IDENTIFIER_SIZE) == 0;
+	printf("Sony CE policy: ioctl_errno=%d identifier_matches=%d\n", error, matches);
+	return matches;
+}
+
+static bool VerifySonyCeKey(const std::string& mount_path,
+                            const android::fscrypt::EncryptionOptions& options,
+                            SonyCeProbe* ce) {
+	std::string secret_hex;
+	android::vold::KeyBuffer wrapped_key;
+	ce->protector_unwrapped = android::keystore::UnlockSonyReadOnlyCe(mount_path, *ce->credential, &secret_hex);
+	const bool retrieved = ce->protector_unwrapped &&
+	    fscrypt_retrieve_ce_key_read_only(mount_path, 0, secret_hex, &wrapped_key);
+	OPENSSL_cleanse(ce->credential->data(), ce->credential->size());
+	ce->credential->clear();
+	OPENSSL_cleanse(secret_hex.data(), secret_hex.size());
+	printf("Sony CE probe: wrapped user key retrieved=%d\n", retrieved);
+	if (!retrieved)
+		return false;
+
+	android::vold::KeyBuffer ephemeral_key;
+	android::fscrypt::EncryptionPolicy policy;
+	const bool installed =
+	    android::vold::exportWrappedStorageKeyWithoutUpgrade(wrapped_key, &ephemeral_key) &&
+	    android::vold::installKey(mount_path, options, ephemeral_key, &policy);
+	printf("Sony CE probe: user key installed=%d\n", installed);
+	if (!installed)
+		return false;
+
+	const bool matches = SonyCePolicyMatches(mount_path + "/media/0", policy);
+	if (matches) {
+		ce->retained_policies.push_back(std::move(policy));
+		return true;
+	}
+	const bool evicted = android::vold::evictKey(mount_path, policy);
+	printf("Sony CE probe: user key evicted=%d\n", evicted);
+	return matches && evicted;
+}
+
+static bool ProbeSonyDeKeys(const char* target, SonyCeProbe* ce) {
+	if (access("/xperia_de_key_probe", F_OK) != 0)
+		return false;
+
+	android::fs_mgr::Fstab fstab;
+	if (!android::fs_mgr::ReadFstabFromFile("/system/etc/fstab.xperia", &fstab)) {
+		printf("Sony DE probe: fstab unavailable\n");
+		return false;
+	}
+	const auto* entry = android::fs_mgr::GetEntryForMountPoint(&fstab, target);
+	android::fscrypt::EncryptionOptions options;
+	if (!entry || !android::fscrypt::ParseOptions(entry->encryption_options, &options) ||
+	    options.version != 2 || !options.use_hw_wrapped_key) {
+		printf("Sony DE probe: unsupported encryption policy\n");
+		return false;
+	}
+
+	const std::string mount_path(target);
+	android::fscrypt::EncryptionPolicy device_policy;
+	const bool device_installed =
+	    InstallSonyProbeKey(mount_path + "/unencrypted/key", target, options, &device_policy);
+	printf("Sony DE probe: system key installed=%d\n", device_installed);
+	if (!device_installed)
+		return false;
+
+	std::ifstream reference(mount_path + fscrypt_key_ref, std::ios::binary);
+	std::string expected(device_policy.key_raw_ref.size(), '\0');
+	const bool reference_matches = reference.read(expected.data(), expected.size()) &&
+	                               reference.peek() == std::char_traits<char>::eof() &&
+	                               expected == device_policy.key_raw_ref;
+	printf("Sony DE probe: system key matches existing filesystem reference=%d\n", reference_matches);
+
+	android::fscrypt::EncryptionPolicy user_policy;
+	const bool user_installed =
+	    InstallSonyProbeKey(mount_path + "/misc/vold/user_keys/de/0", target, options, &user_policy);
+	printf("Sony DE probe: user 0 device-encrypted key installed=%d\n", user_installed);
+	bool verified = reference_matches && user_installed;
+	if (verified && ce) {
+		if (ce->credential) {
+			verified = VerifySonyCeKey(mount_path, options, ce);
+		} else {
+			ce->credential_type = android::keystore::GetSonyReadOnlyCredentialType(mount_path);
+			verified = ce->credential_type != 0;
+			printf("Sony CE UI: supported local credential=%d\n", verified);
+		}
+	} else if (verified && access("/xperia_ce_preflight", F_OK) == 0) {
+		KeystoreInfo keystore;
+		const bool hardware_probe = access("/xperia_ce_keymint_preflight", F_OK) == 0;
+		auto blob = keystore.probeUserProtector(mount_path, 0, hardware_probe);
+		if (hardware_probe)
+			ProbeSonyProtectorHardware(blob);
+	}
+	if (verified && ce && !ce->retained_policies.empty()) {
+		ce->retained_policies.push_back(std::move(user_policy));
+		ce->retained_policies.push_back(std::move(device_policy));
+		return true;
+	}
+	const bool user_evicted = !user_installed || android::vold::evictKey(target, user_policy);
+	const bool device_evicted = android::vold::evictKey(target, device_policy);
+	if (!user_evicted)
+		printf("Sony DE probe: user 0 key eviction failed\n");
+	if (!device_evicted)
+		printf("Sony DE probe: system key eviction failed\n");
+	return verified && user_evicted && device_evicted;
+}
+
+constexpr char kSonyMetadataMapper[] = "userdata";
+constexpr char kSonyUserdataMount[] = "/data";
+static std::vector<android::fscrypt::EncryptionPolicy> sony_browse_policies;
+
+// Retained policy identifiers are not proof that keys survived unmount.
+static bool SonyBrowseKeysPresent() {
+    if (sony_browse_policies.size() != 3)
+        return false;
+    for (const auto& policy : sony_browse_policies) {
+        if (policy.options.version != 2 ||
+            policy.key_raw_ref.size() != FSCRYPT_KEY_IDENTIFIER_SIZE)
+            return false;
+    }
+    const int fd = open(kSonyUserdataMount, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0)
+        return false;
+    bool present = true;
+    for (const auto& policy : sony_browse_policies) {
+        struct fscrypt_get_key_status_arg status {};
+        status.key_spec.type = FSCRYPT_KEY_SPEC_TYPE_IDENTIFIER;
+        memcpy(status.key_spec.u.identifier, policy.key_raw_ref.data(), FSCRYPT_KEY_IDENTIFIER_SIZE);
+        if (ioctl(fd, FS_IOC_GET_ENCRYPTION_KEY_STATUS, &status) != 0 ||
+            status.status != FSCRYPT_KEY_STATUS_PRESENT) {
+            present = false;
+            break;
+        }
+    }
+    close(fd);
+    return present;
+}
+
+static bool EvictSonyBrowseKeys(const std::vector<android::fscrypt::EncryptionPolicy>& policies) {
+	bool evicted = true;
+	for (const auto& policy : policies)
+		evicted = android::vold::evictKey(kSonyUserdataMount, policy) && evicted;
+	return evicted;
+}
+
+static bool sony_native_policy_maps_owned = false;
+static std::string sony_owned_data_device;
+
+static void ClearSonyNativePolicyMaps() {
+    if (!sony_native_policy_maps_owned)
+        return;
+    s_ce_policies.erase(0);
+    s_de_policies.erase(0);
+    de_key_raw_ref.clear();
+    sony_native_policy_maps_owned = false;
+}
+
+static bool RegisterSonyNativePolicyMaps(
+        const std::vector<android::fscrypt::EncryptionPolicy>& policies) {
+    // ProbeSonyDeKeys retains user CE, user DE, then system DE, in that order.
+    // These are policy identifiers, not credential or encryption-key bytes.
+    if (policies.size() != 3 || sony_native_policy_maps_owned ||
+        !de_key_raw_ref.empty() || s_ce_policies.count(0) || s_de_policies.count(0))
+        return false;
+    for (const auto& policy : policies) {
+        if (policy.options.version != 2 ||
+            policy.key_raw_ref.size() != FSCRYPT_KEY_IDENTIFIER_SIZE)
+            return false;
+    }
+    if (policies[0].key_raw_ref == policies[1].key_raw_ref ||
+        policies[0].key_raw_ref == policies[2].key_raw_ref ||
+        policies[1].key_raw_ref == policies[2].key_raw_ref)
+        return false;
+    s_ce_policies.emplace(0, UserPolicies{policies[0], {}});
+    s_de_policies.emplace(0, UserPolicies{policies[1], {}});
+    de_key_raw_ref = policies[2].key_raw_ref;
+    sony_native_policy_maps_owned = true;
+    return true;
+}
+
+static bool RegisterSonyNativeData() {
+    std::string device;
+    if (!android::dm::DeviceMapper::Instance().GetDmDevicePathByName(kSonyMetadataMapper, &device))
+        return false;
+    const bool registered = PartitionManager.Adopt_Decrypted_Data(device);
+    if (registered) sony_owned_data_device = device;
+    printf("Sony CE data: native_data_registered=%d\n", registered);
+    if (!registered) {
+        const int available = klogctl(10, nullptr, 0);
+        const int capacity = available > 0 ? std::min(available, 16 * 1024 * 1024) : 512 * 1024;
+        std::vector<char> buffer(capacity);
+        const int bytes = klogctl(3, buffer.data(), buffer.size());
+        if (bytes < 0) {
+            printf("Sony Data scan AVC: kernel log unavailable errno=%d\n", errno);
+        } else {
+            const auto summaries = XperiaDataScanAvcSummary(std::string_view(buffer.data(), bytes));
+            for (const auto& summary : summaries)
+                printf("Sony Data scan AVC: %s\n", summary.c_str());
+            printf("Sony Data scan AVC: distinct recovery denials=%zu (kernel ring may include earlier events)\n", summaries.size());
+        }
+    }
+    if (registered && access("/xperia_load_probe", F_OK) == 0) {
+        std::vector<PartitionList> entries;
+        PartitionManager.Get_Partition_List("backup", &entries);
+        for (const auto& entry : entries)
+            printf("Native Backup after CE: %s -> %s\n", entry.Mount_Point.c_str(), entry.Display_Name.c_str());
+    }
+    return registered;
+}
+
+static void ReleaseSonyDecryptedData() {
+    if (sony_browse_policies.empty())
+        return;
+    // Evict while /data still names the filesystem holding these policies.
+    const bool keys_evicted = EvictSonyBrowseKeys(sony_browse_policies);
+    const bool data_released = PartitionManager.UnMount_By_Path(kSonyUserdataMount, false);
+    const bool mapper_released = data_released &&
+        android::dm::DeviceMapper::Instance().DeleteDevice(kSonyMetadataMapper);
+    ClearSonyNativePolicyMaps();
+    sony_browse_policies.clear();
+    printf("Sony CE data: keys_evicted=%d data_released=%d mapper_released=%d\n",
+           keys_evicted, data_released, mapper_released);
+}
+
+// Delete only the mapper we adopted, after all Data mounts are gone.
+// A busy mapper is deliberately retained; never use deferred/forced deletion.
+static bool ReleaseSonyUnmountedMapper() {
+    if (sony_owned_data_device.empty()) return true;
+    if (!sony_browse_policies.empty() || PartitionManager.Is_Mounted_By_Path("/data"))
+        return false;
+    auto& dm = android::dm::DeviceMapper::Instance();
+    if (dm.GetState(kSonyMetadataMapper) != android::dm::DmDeviceState::INVALID) {
+        std::string current;
+        if (!dm.GetDmDevicePathByName(kSonyMetadataMapper, &current) ||
+            current != sony_owned_data_device || !dm.DeleteDevice(kSonyMetadataMapper))
+            return false;
+    }
+    sony_owned_data_device.clear();
+    return true;
+}
+
+static bool MountSonyEncryptedData(SonyCeProbe* ce = nullptr) {
+	if (access("/xperia_metadata_probe", F_OK) != 0)
+		return false;
+    if (!ReleaseSonyUnmountedMapper()) {
+        printf("Sony Data: previous mapper is still busy or ownership changed\n");
+        return false;
+    }
+
+	constexpr char metadata[] = "/metadata";
+	const auto* dm_name = kSonyMetadataMapper;
+	const auto* target = kSonyUserdataMount;
+	constexpr unsigned long flags = MS_NOSUID | MS_NODEV;
+	auto& dm = android::dm::DeviceMapper::Instance();
+	if (dm.GetState(dm_name) != android::dm::DmDeviceState::INVALID) {
+		printf("Sony metadata probe: mapper already exists, stopping\n");
+		return false;
+	}
+	if (mount("/dev/block/by-name/metadata", metadata, "f2fs", flags, nullptr) < 0) {
+		printf("Sony metadata probe: metadata mount failed: %s\n", strerror(errno));
+		return false;
+	}
+	struct statvfs info {};
+	const bool metadata_writable = statvfs(metadata, &info) == 0 && !(info.f_flag & ST_RDONLY);
+	printf("Sony metadata probe: metadata writable=%d\n", metadata_writable);
+	if (metadata_writable && DataManager::GetIntValue("tw_xperia_storage_status") == 1)
+		DataManager::SetValue("tw_xperia_storage_metadata", "F2FS - mounted");
+	const bool mounted = metadata_writable && android::vold::fscrypt_mount_metadata_encrypted(
+	    "/dev/block/bootdevice/by-name/userdata", target, false, false, "f2fs", "",
+	    "/system/etc/fstab.xperia", "");
+	bool verified = false;
+	if (mounted) {
+		const bool writable = statvfs(target, &info) == 0 && !(info.f_flag & ST_RDONLY);
+		printf("Sony metadata probe: metadata-encrypted F2FS writable=%d\n", writable);
+		if (writable) {
+			verified = ProbeSonyDeKeys(target, ce);
+			if (ce)
+				ce->data_capacity = SonyStorageCapacity(info);
+		}
+	} else {
+		printf("Sony metadata probe: metadata-encrypted F2FS mount failed\n");
+	}
+	bool metadata_unmounted = false;
+	if (ce && !ce->retained_policies.empty()) {
+		metadata_unmounted = umount(metadata) == 0;
+        const bool policies_registered = verified && metadata_unmounted &&
+            RegisterSonyNativePolicyMaps(ce->retained_policies);
+        if (policies_registered && RegisterSonyNativeData()) {
+			sony_browse_policies = std::move(ce->retained_policies);
+			return true;
+		}
+        if (policies_registered) ClearSonyNativePolicyMaps();
+		EvictSonyBrowseKeys(ce->retained_policies);
+		ce->retained_policies.clear();
+		verified = false;
+	}
+	const bool unmounted = !mounted || umount(target) == 0;
+	if (!unmounted)
+		printf("Sony metadata probe: target unmount failed: %s\n", strerror(errno));
+	if (unmounted && dm.GetState(dm_name) != android::dm::DmDeviceState::INVALID &&
+	    !dm.DeleteDevice(dm_name)) {
+		printf("Sony metadata probe: mapper cleanup failed\n");
+	}
+	metadata_unmounted = metadata_unmounted || umount(metadata) == 0;
+	if (!metadata_unmounted)
+		printf("Sony metadata probe: metadata unmount failed: %s\n", strerror(errno));
+	const bool cleaned = metadata_unmounted && unmounted &&
+	                     dm.GetState(dm_name) == android::dm::DmDeviceState::INVALID;
+	if (cleaned)
+		printf("Sony metadata probe: temporary mounts and mapper released\n");
+	return verified && cleaned;
+}
+
+// Temporary read-only diagnostics for absent power_supply devices.
+static void LogSonyHealthKernel() {
+    for (const char* root : {"/vendor/firmware_mnt/image", "/vendor/firmware", "/firmware/image"}) {
+        for (const char* name : {"adsp.mdt", "adsp.b00", "adsp.b01", "adsp.b02", "adsp.b03", "adsp.b04", "adsp.b05"}) {
+            const std::string path = std::string(root) + "/" + name;
+            struct stat info {};
+            const int result = stat(path.c_str(), &info);
+            const int saved_errno = errno;
+            char* context = nullptr;
+            getfilecon(path.c_str(), &context);
+            printf("Sony ADSP firmware file: %s result=%d errno=%d size=%lld label=%s\n",
+                   path.c_str(), result, result ? saved_errno : 0,
+                   result ? -1LL : static_cast<long long>(info.st_size), context ? context : "unavailable");
+            freecon(context);
+        }
+    }
+    const char* firmware_path = "/sys/module/firmware_class/parameters/path";
+    std::ifstream firmware_stream(firmware_path);
+    std::string configured_path;
+    if (std::getline(firmware_stream, configured_path))
+        printf("Sony ADSP kernel search path: '%s'\n", configured_path.c_str());
+    else
+        printf("Sony ADSP kernel search path unreadable or empty, errno=%d\n", errno);
+    for (const char* path : {firmware_path, "/sys/class/remoteproc/remoteproc0/state"}) {
+        char* context = nullptr;
+        getfilecon(path, &context);
+        printf("Sony ADSP control label: %s %s\n", path, context ? context : "unavailable");
+        freecon(context);
+    }
+    for (int index = 0; index < 5; ++index) {
+        const std::string root = "/sys/class/remoteproc/remoteproc" + std::to_string(index);
+        for (const char* leaf : {"name", "state", "firmware"}) {
+            std::ifstream stream(root + "/" + leaf);
+            std::string value;
+            if (std::getline(stream, value))
+                printf("Sony health remoteproc%d %s=%s\n", index, leaf, value.c_str());
+        }
+    }
+    const int available = klogctl(10, nullptr, 0);
+    const int size = available > 0 ? std::min(available, 16 * 1024 * 1024) : 1024 * 1024;
+    std::vector<char> buffer(size);
+    const int count = klogctl(3, buffer.data(), buffer.size());
+    if (count < 0) {
+        printf("Sony health kernel unavailable: %s\n", strerror(errno));
+        return;
+    }
+    std::string_view rest(buffer.data(), count);
+    size_t printed = 0;
+    while (!rest.empty() && printed < 160) {
+        const size_t end = rest.find('\n');
+        const auto line = rest.substr(0, end);
+        if (line.find("battery") != std::string_view::npos ||
+            line.find("charger") != std::string_view::npos ||
+            line.find("pmic_glink") != std::string_view::npos ||
+            line.find("remoteproc") != std::string_view::npos ||
+            line.find("adsp") != std::string_view::npos ||
+            line.find("firmware") != std::string_view::npos ||
+            line.find("health") != std::string_view::npos) {
+            printf("Sony health kernel: %.*s\n", static_cast<int>(line.size()), line.data());
+            ++printed;
+        }
+        if (end == std::string_view::npos) break;
+        rest.remove_prefix(end + 1);
+    }
+}
