+constexpr char kSonySpblobPath[] = "/system_de/0/spblob/";
+constexpr size_t kSpHeaderSize = 2;
+constexpr size_t kGcmNonceSize = 12;
+constexpr size_t kGcmTagSize = 16;
+
+using AidlGatekeeper = aidl::android::hardware::gatekeeper::IGatekeeper;
+using VerifyResponse = aidl::android::hardware::gatekeeper::GatekeeperVerifyResponse;
+
+bool IsAvailableDataRoot(const std::string& data_root) {
+	struct statvfs mount_info {};
+	return statvfs(data_root.c_str(), &mount_info) == 0 && mount_info.f_blocks != 0;
+}
+
+struct SonyPasswordData : password_data_struct {
+	SonyPasswordData() : password_data_struct{} {}
+	~SonyPasswordData() {
+		free(salt);
+		free(password_handle);
+	}
+};
+
+struct SensitiveDigest {
+	void* data;
+	~SensitiveDigest() {
+		if (data) {
+			OPENSSL_cleanse(data, SHA512_DIGEST_LENGTH);
+			free(data);
+		}
+	}
+};
+
+bool HasGatekeeperProtector(const std::string& path, const std::string& handle,
+                            SonyPasswordData* pwd) {
+	if (handle.empty() || handle.size() > 16)
+		return false;
+	const auto weaver = path + std::string(16 - handle.size(), '0') + handle + ".weaver";
+	struct stat info {};
+	return lstat(weaver.c_str(), &info) == -1 && errno == ENOENT &&
+	       Get_Password_Data(path, handle, pwd) && pwd->handle_len > 0;
+}
+
+std::shared_ptr<AidlGatekeeper> GetSonyGatekeeper() {
+	ndk::SpAIBinder binder(
+	    AServiceManager_checkService("android.hardware.gatekeeper.IGatekeeper/default"));
+	return AidlGatekeeper::fromBinder(binder);
+}
+
+bool SonyProtectorMatchesReference(const std::string& handle) {
+	std::string reference;
+	if (!android::base::ReadFileToString("/xperia_ce_protector_reference", &reference)) {
+		if (errno == ENOENT)
+			return true;  // Only diagnostic images carry this opt-in record.
+		printf("Sony CE protector reference: read_error=%d\n", errno);
+		return false;
+	}
+	if (reference.size() != SHA256_DIGEST_LENGTH || handle.empty() || handle.size() > 16) {
+		printf("Sony CE protector reference: invalid record\n");
+		return false;
+	}
+	const std::string canonical = std::string(16 - handle.size(), '0') + handle;
+	unsigned char digest[SHA256_DIGEST_LENGTH];
+	SHA256(reinterpret_cast<const unsigned char*>(canonical.data()), canonical.size(), digest);
+	const bool matches = CRYPTO_memcmp(reference.data(), digest, sizeof(digest)) == 0;
+	printf("Sony CE protector reference: matches=%d\n", matches);
+	return matches;
+}
+
+bool ReadSonyProtectorRecords(const std::string& path, const std::string& handle,
+                             SonyPasswordData* pwd, std::string* spblob, std::string* secdis) {
+	const bool supported =
+	    HasGatekeeperProtector(path, handle, pwd) &&
+	    Get_Spblob_Data(path, handle, ".spblob", "spblob", spblob) &&
+	    spblob->size() > kSpHeaderSize + kGcmNonceSize + kGcmTagSize &&
+	    spblob->size() <= 4096 &&
+	    (*spblob)[0] == SYNTHETIC_PASSWORD_VERSION_V3 &&
+	    (*spblob)[1] == SYNTHETIC_PASSWORD_PASSWORD_BASED &&
+	    Get_Secdis(path, handle, *secdis) && secdis->size() == 16 * 1024;
+	printf("Sony CE unlock: supported protector records=%d\n", supported);
+	return supported;
+}
+
+bool VerifySonyGatekeeper(AidlGatekeeper& gatekeeper, const SonyPasswordData& pwd,
+                          const vold::KeyBuffer& stretched, HardwareAuthToken* token) {
+	const SensitiveDigest digest {
+	    PersonalizedHashBinary(PERSONALIZATION_USER_GK_AUTH, stretched.data(), stretched.size())
+	};
+	if (!digest.data)
+		return false;
+
+	const auto* handle = static_cast<const uint8_t*>(pwd.password_handle);
+	const auto* bytes = static_cast<const uint8_t*>(digest.data);
+	std::vector<uint8_t> credential(bytes, bytes + SHA512_DIGEST_LENGTH);
+	VerifyResponse response{};
+	const auto status = gatekeeper.verify(fakeUid(0), 0, {handle, handle + pwd.handle_len},
+	                                      credential, &response);
+	OPENSSL_cleanse(credential.data(), credential.size());
+	*token = std::move(response.hardwareAuthToken);
+	const bool authenticated =
+	    status.isOk() && (response.statusCode == AidlGatekeeper::STATUS_OK ||
+	                      response.statusCode == AidlGatekeeper::STATUS_REENROLL) &&
+	    token->mac.size() == sizeof(hw_auth_token_t::hmac);
+	printf("Sony CE Gatekeeper: authenticated=%d binder_status=%d service_error=%d response=%d timeout_ms=%d\n",
+	       authenticated, status.getStatus(), status.getServiceSpecificError(),
+	       response.statusCode, response.timeoutMs);
+	return authenticated;
+}
+
+bool UnwrapSonyProtector(keymint::IKeyMintDevice& device, const std::vector<uint8_t>& key_blob,
+                         const std::string& spblob, const HardwareAuthToken& token,
+                         std::vector<uint8_t>* inner) {
+	const auto nonce_start = spblob.begin() + kSpHeaderSize;
+	const auto body_start = nonce_start + kGcmNonceSize;
+	const std::vector<uint8_t> nonce(nonce_start, body_start);
+	const auto params = keymint::AuthorizationSetBuilder()
+	    .GcmModeMacLen(kGcmTagSize * 8)
+	    .Authorization(keymint::TAG_NONCE, nonce);
+
+	keymint::BeginResult result;
+	auto status = device.begin(keymint::KeyPurpose::DECRYPT, key_blob, params.vector_data(),
+	                           token, &result);
+	printf("Sony CE KeyMint begin: ok=%d binder_status=%d service_error=%d\n",
+	       status.isOk(), status.getStatus(), status.getServiceSpecificError());
+	if (!status.isOk() || !result.operation)
+		return false;
+
+	const std::vector<uint8_t> body(body_start, spblob.end());
+	status = result.operation->finish(body, std::nullopt, token, std::nullopt, std::nullopt, inner);
+	printf("Sony CE KeyMint finish: ok=%d binder_status=%d service_error=%d\n",
+	       status.isOk(), status.getStatus(), status.getServiceSpecificError());
+	return status.isOk();
+}
