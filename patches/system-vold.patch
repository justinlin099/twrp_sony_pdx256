+static bool ParsePasswordData(const std::string& record, password_data_struct* pwd) {
+	constexpr size_t salt_offset = 11;
+	if (record.size() < salt_offset + sizeof(uint32_t))
+		return false;
+
+	const auto* bytes = reinterpret_cast<const uint8_t*>(record.data());
+	const auto read_uint32 = [](const uint8_t* p) {
+		return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+		       (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+	};
+	const uint32_t salt_len = read_uint32(bytes + 7);
+	if (salt_len == 0 || salt_len > INT_MAX ||
+	    salt_len > record.size() - salt_offset - sizeof(uint32_t))
+		return false;
+	const size_t handle_offset = salt_offset + salt_len + sizeof(uint32_t);
+	const uint32_t handle_len = read_uint32(bytes + handle_offset - sizeof(uint32_t));
+	if (handle_len > INT_MAX || handle_len > record.size() - handle_offset)
+		return false;
+
+	void* salt = malloc(salt_len);
+	void* handle = handle_len != 0 ? malloc(handle_len) : nullptr;
+	if (!salt || (handle_len != 0 && !handle)) {
+		free(salt);
+		free(handle);
 		return false;
 	}
