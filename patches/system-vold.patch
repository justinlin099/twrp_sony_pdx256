+static bool VerifySyntheticGatekeeper(uint32_t user_id, const uint8_t* handle,
+                                      size_t handle_size, const uint8_t* key, size_t key_size) {
+	using AidlGatekeeper = aidl::android::hardware::gatekeeper::IGatekeeper;
+	using AidlVerifyResponse = aidl::android::hardware::gatekeeper::GatekeeperVerifyResponse;
+	using aidl::android::security::authorization::IKeystoreAuthorization;
+	using android::hardware::gatekeeper::V1_0::GatekeeperStatusCode;
+	using HidlGatekeeper = android::hardware::gatekeeper::V1_0::IGatekeeper;
+
+	::ndk::SpAIBinder auth_binder(AServiceManager_checkService("android.security.authorization"));
+	auto authorization = IKeystoreAuthorization::fromBinder(auth_binder);
+	if (!authorization) {
+		printf("Keystore authorization service is unavailable\n");
+		return false;
+	}
+
+	HardwareAuthToken auth_token;
+	::ndk::SpAIBinder gatekeeper_binder(
+			AServiceManager_checkService("android.hardware.gatekeeper.IGatekeeper/default"));
+	auto aidl_gatekeeper = AidlGatekeeper::fromBinder(gatekeeper_binder);
+	if (aidl_gatekeeper) {
+		AidlVerifyResponse response;
+		auto result = aidl_gatekeeper->verify(user_id, 0, {handle, handle + handle_size},
+		                                     {key, key + key_size}, &response);
+		if (!result.isOk() || (response.statusCode != AidlGatekeeper::STATUS_OK &&
+		                      response.statusCode != AidlGatekeeper::STATUS_REENROLL)) {
+			printf("AIDL Gatekeeper verification failed\n");
+			return false;
+		}
+		auth_token = std::move(response.hardwareAuthToken);
+	} else {
+		auto hidl_gatekeeper = HidlGatekeeper::getService();
+		if (!hidl_gatekeeper) {
+			printf("Gatekeeper service is unavailable\n");
+			return false;
+		}
+		android::hardware::hidl_vec<uint8_t> hidl_handle;
+		hidl_handle.setToExternal(const_cast<uint8_t*>(handle), handle_size);
+		android::hardware::hidl_vec<uint8_t> hidl_key;
+		hidl_key.setToExternal(const_cast<uint8_t*>(key), key_size);
+		auto result = hidl_gatekeeper->verify(user_id, 0, hidl_handle, hidl_key,
+				[&auth_token](const GatekeeperResponse& response) {
+			if (response.code < GatekeeperStatusCode::STATUS_OK ||
+			    response.data.size() != sizeof(hw_auth_token_t)) {
+				return;
+			}
+			hw_auth_token_t token;
+			memcpy(&token, response.data.data(), sizeof(token));
+			auth_token.timestamp.milliSeconds = betoh64(token.timestamp);
+			auth_token.challenge = token.challenge;
+			auth_token.userId = token.user_id;
+			auth_token.authenticatorId = token.authenticator_id;
+			auth_token.authenticatorType =
+					static_cast<HardwareAuthenticatorType>(betoh32(token.authenticator_type));
+			auth_token.mac.assign(token.hmac, token.hmac + sizeof(token.hmac));
+		});
+		if (!result.isOk()) {
+			printf("HIDL Gatekeeper verification failed\n");
+			return false;
+		}
+	}
+
+	if (auth_token.mac.size() != sizeof(hw_auth_token_t::hmac)) {
+		printf("Gatekeeper returned no valid hardware authentication token\n");
+		return false;
+	}
+	return authorization->addAuthToken(auth_token).isOk();
+}
