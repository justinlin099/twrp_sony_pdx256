+// Read the frozen source database and its recovery sidecars into a private tmpfs
+// directory. SQLite can rebuild a missing WAL index without writing to /data.
+class ProbeDbSnapshot {
+public:
+	~ProbeDbSnapshot() { clear(); }
+
+	int openDb(const std::string& source, sqlite3** db) {
+		struct statfs info {};
+		if (statfs("/tmp", &info) != 0 || info.f_type != TMPFS_MAGIC)
+			return SQLITE_CANTOPEN;
+		char dir[] = "/tmp/xperia-ce-db.XXXXXX";
+		if (!mkdtemp(dir)) return SQLITE_CANTOPEN;
+		path_ = std::string(dir) + "/probe.sqlite";
+
+		off_t budget = 64 * 1024 * 1024;
+		for (const char* suffix : {"", "-wal", "-journal"}) {
+			if (!copyFile(source + suffix, path_ + suffix, *suffix != 0, &budget))
+				return SQLITE_IOERR;
+		}
+
+		int rc = sqlite3_open_v2(path_.c_str(), db, SQLITE_OPEN_READWRITE, nullptr);
+		if (rc == SQLITE_OK)
+			rc = sqlite3_exec(*db, "PRAGMA query_only=ON; PRAGMA temp_store=MEMORY;",
+			                  nullptr, nullptr, nullptr);
+		return rc;
+	}
+
+	void clear() {
+		if (path_.empty()) return;
+		for (const char* suffix : {"", "-wal", "-shm", "-journal"})
+			unlink((path_ + suffix).c_str());
+		rmdir(path_.substr(0, path_.rfind('/')).c_str());
+		path_.clear();
+	}
+
+private:
+	static bool copyFile(const std::string& source, const std::string& target,
+	                     bool optional, off_t* budget) {
+		int input = open(source.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+		if (input < 0) return optional && errno == ENOENT;
+
+		struct stat info {};
+		if (fstat(input, &info) != 0 || !S_ISREG(info.st_mode) ||
+		    info.st_size < 0 || info.st_size > *budget) {
+			close(input);
+			return false;
+		}
+		int output = open(target.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+		if (output < 0) {
+			close(input);
+			return false;
+		}
+
+		char buffer[16384];
+		off_t remaining = info.st_size;
+		bool ok = true;
+		while (ok && remaining > 0) {
+			const auto request = std::min<off_t>(remaining, sizeof(buffer));
+			const ssize_t count = TEMP_FAILURE_RETRY(read(input, buffer, request));
+			if (count <= 0) {
+				ok = false;
+				break;
+			}
+			for (ssize_t offset = 0; offset < count;) {
+				const ssize_t written =
+				    TEMP_FAILURE_RETRY(write(output, buffer + offset, count - offset));
+				if (written <= 0) {
+					ok = false;
+					break;
+				}
+				offset += written;
+			}
+			remaining -= count;
+		}
+		*budget -= info.st_size;
+		close(input);
+		return close(output) == 0 && ok;
+	}
+
+	std::string path_;
+};
+
+static int regularFileStatus(const std::string& path) {
+	struct stat status {};
+	if (lstat(path.c_str(), &status) != 0) return errno;
+	return S_ISREG(status.st_mode) ? 0 : EINVAL;
+}
+
+std::string KeystoreInfo::getReadOnlyHandle(const std::string& read_only_data_root,
+                                            userid_t user_id) {
+	sqlite3* db = nullptr;
+	sqlite3_stmt* stmt = nullptr;
+	const std::string locksettings = read_only_data_root + "/system/locksettings.db";
+	ProbeDbSnapshot snapshot;
+	int rc = snapshot.openDb(locksettings, &db);
+	if (rc == SQLITE_OK) {
+		rc = sqlite3_prepare_v2(db,
+		    "SELECT value FROM locksettings WHERE name = 'sp-handle' AND user = ?1",
+		    -1, &stmt, nullptr);
+	}
+	if (rc == SQLITE_OK) rc = sqlite3_bind_int64(stmt, 1, user_id);
+	if (rc == SQLITE_OK) rc = sqlite3_step(stmt);
+	const auto handle = rc == SQLITE_ROW ? uint2hex(sqlite3_column_int64(stmt, 0)) : std::string();
+	sqlite3_finalize(stmt);
+	if (db) sqlite3_close(db);
+	printf("Sony CE probe: locksettings_rc=%d active_protector=%d\n", rc, !handle.empty());
+	return handle.size() <= 16 ? handle : std::string();
+}
+
+std::vector<uint8_t> KeystoreInfo::probeUserProtector(const std::string& read_only_data_root,
+                                                     userid_t user_id, bool read_keymint_blob) {
+	const auto handle = getReadOnlyHandle(read_only_data_root, user_id);
+	if (handle.empty()) return {};
+
+	const std::string sp = read_only_data_root + "/system_de/" + std::to_string(user_id) +
+	                       "/spblob/" + std::string(16 - handle.size(), '0') + handle;
+	int fd = open((sp + ".spblob").c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	unsigned char sp_header[2] {};
+	int blob_error = fd < 0 ? errno : 0;
+	if (fd >= 0) {
+		const auto size = TEMP_FAILURE_RETRY(read(fd, sp_header, sizeof(sp_header)));
+		if (size != static_cast<ssize_t>(sizeof(sp_header))) blob_error = size < 0 ? errno : EIO;
+		close(fd);
+	}
+	printf("Sony CE probe: blob_errno=%d version=%u protector_type=%u pwd_errno=%d weaver_errno=%d\n",
+	       blob_error, sp_header[0], sp_header[1], regularFileStatus(sp + ".pwd"),
+	       regularFileStatus(sp + ".weaver"));
+
+	return getReadOnlyProtectorBlob(read_only_data_root, handle, read_keymint_blob);
+}
+
+std::vector<uint8_t> KeystoreInfo::getReadOnlyProtectorBlob(
+        const std::string& read_only_data_root, const std::string& handle, bool read_keymint_blob) {
+	sqlite3* db = nullptr;
+	sqlite3_stmt* stmt = nullptr;
+	ProbeDbSnapshot snapshot;
+	int rc = snapshot.openDb(read_only_data_root + "/misc/keystore/persistent.sqlite", &db);
+	if (rc == SQLITE_OK) {
+		rc = sqlite3_prepare_v2(db,
+		    // EncryptedBy is blobmetadata tag 0. Reject super-encrypted blobs rather
+		    // than handing those bytes to the hardware as if they were a KeyMint blob.
+		    "WITH selected AS (SELECT b.id,b.blob,EXISTS(SELECT 1 FROM blobmetadata AS m "
+		    "WHERE m.blobentryid=b.id AND m.tag=0) AS wrapped "
+		    "FROM keyentry AS k JOIN blobentry AS b ON b.keyentryid=k.id "
+		    "WHERE k.key_type=0 AND k.domain=2 AND k.namespace=103 AND k.state=1 "
+		    "AND k.alias IN (?1, CAST(?1 AS BLOB)) AND b.subcomponent_type=0 "
+		    "ORDER BY b.id DESC LIMIT 1) "
+		    "SELECT wrapped,CASE WHEN ?2=1 AND wrapped=0 THEN blob END FROM selected",
+		    -1, &stmt, nullptr);
+	}
+	const std::string alias = getAlias(handle);
+	if (rc == SQLITE_OK) rc = sqlite3_bind_text(stmt, 1, alias.c_str(), -1, SQLITE_TRANSIENT);
+	if (rc == SQLITE_OK) rc = sqlite3_bind_int(stmt, 2, read_keymint_blob);
+	if (rc == SQLITE_OK) rc = sqlite3_step(stmt);
+	const bool protector_key = rc == SQLITE_ROW;
+	const bool wrapped = protector_key && sqlite3_column_int(stmt, 0) != 0;
+	std::vector<uint8_t> key_blob;
+	if (protector_key && read_keymint_blob && !wrapped) {
+		const auto* bytes = static_cast<const uint8_t*>(sqlite3_column_blob(stmt, 1));
+		const int size = sqlite3_column_bytes(stmt, 1);
+		if (bytes && size > 0 && size <= 65536)
+			key_blob.assign(bytes, bytes + size);
+	}
+	sqlite3_finalize(stmt);
+	if (db) sqlite3_close(db);
+	printf("Sony CE probe: keystore_rc=%d live_protector_blob=%d software_wrapped=%d\n",
+	       rc, protector_key, wrapped);
