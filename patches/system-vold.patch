+int GetSonyReadOnlyCredentialType(const std::string& data_root) {
+	if (!IsAvailableDataRoot(data_root))
+		return 0;
+	KeystoreInfo keystore;
+	SonyPasswordData pwd;
+	std::string spblob;
+	std::string secdis;
+	const auto handle = keystore.getReadOnlyHandle(data_root, 0);
+	if (!SonyProtectorMatchesReference(handle))
+		return 0;
+	const bool supported =
+	    ReadSonyProtectorRecords(data_root + kSonySpblobPath, handle, &pwd, &spblob, &secdis);
+	OPENSSL_cleanse(secdis.data(), secdis.size());
+	if (!supported)
+		return 0;
+
+	auto gatekeeper = GetSonyGatekeeper();
+	int32_t version = 0;
+	const bool gatekeeper_ready =
+	    gatekeeper && gatekeeper->getInterfaceVersion(&version).isOk() && version > 0;
+	printf("Sony CE UI: Gatekeeper transaction=%d\n", gatekeeper_ready);
+	if (!gatekeeper_ready)
+		return 0;
+
+	switch (pwd.password_type) {
+	case 1: return 2;  // Pattern
+	case 2:           // Legacy PIN or password
+	case 4: return 1;  // Password
+	case 3: return 3;  // PIN
+	default: return 0;
+	}
+}
