+bool UnlockSonyReadOnlyCe(const std::string& data_root, const std::string& password,
+                          std::string* secret_hex) {
+	if (password.empty() || !IsAvailableDataRoot(data_root))
+		return false;
+
+	KeystoreInfo keystore;
+	const auto path = data_root + kSonySpblobPath;
+	const auto handle = keystore.getReadOnlyHandle(data_root, 0);
+	if (!SonyProtectorMatchesReference(handle))
+		return false;
+	SonyPasswordData pwd;
+	std::string spblob;
+	std::string secdis;
+	if (!ReadSonyProtectorRecords(path, handle, &pwd, &spblob, &secdis)) {
+		OPENSSL_cleanse(secdis.data(), secdis.size());
+		return false;
+	}
+
+	auto key_blob = keystore.getReadOnlyProtectorBlob(data_root, handle);
+	auto gatekeeper = GetSonyGatekeeper();
+	ndk::SpAIBinder keymint_binder(AServiceManager_checkService(
+	    "android.hardware.security.keymint.IKeyMintDevice/default"));
+	auto device = keymint::IKeyMintDevice::fromBinder(keymint_binder);
+	if (key_blob.empty() || !gatekeeper || !device) {
+		OPENSSL_cleanse(secdis.data(), secdis.size());
+		printf("Sony CE unlock: protector or hardware service unavailable\n");
+		return false;
+	}
+
+	vold::KeyBuffer application_id(PASSWORD_TOKEN_SIZE + SHA512_DIGEST_LENGTH);
+	vold::KeyBuffer stretched(PASSWORD_TOKEN_SIZE);
+	const SensitiveDigest secdis_hash {
+	    PersonalizedHashBinary(PERSONALISATION_SECDISCARDABLE, secdis.data(), secdis.size())
+	};
+	OPENSSL_cleanse(secdis.data(), secdis.size());
+	if (!secdis_hash.data ||
+	    !Get_Password_Token(&pwd, password, reinterpret_cast<unsigned char*>(stretched.data())))
+		return false;
+
+	memcpy(application_id.data(), stretched.data(), stretched.size());
+	memcpy(application_id.data() + stretched.size(), secdis_hash.data, SHA512_DIGEST_LENGTH);
+	const SensitiveDigest application_hash {
+	    PersonalizedHashBinary(PERSONALISATION_APPLICATION_ID, application_id.data(),
+	                           application_id.size())
+	};
+	if (!application_hash.data)
+		return false;
+
+	// One local credential submission yields at most one Gatekeeper verification.
+	HardwareAuthToken token;
+	std::vector<uint8_t> inner;
+	const bool unwrapped = VerifySonyGatekeeper(*gatekeeper, pwd, stretched, &token) &&
+	                       UnwrapSonyProtector(*device, key_blob, spblob, token, &inner);
+	OPENSSL_cleanse(token.mac.data(), token.mac.size());
+	OPENSSL_cleanse(key_blob.data(), key_blob.size());
+
+	std::string synthetic_password;
+	const bool authenticated = unwrapped && decryptSyntheticPasswordGcm(
+	    static_cast<const unsigned char*>(application_hash.data), inner, &synthetic_password);
+	OPENSSL_cleanse(inner.data(), inner.size());
+	printf("Sony CE unlock: inner GCM authenticated=%d\n", authenticated);
+	if (!authenticated)
+		return false;
+
+	*secret_hex = PersonalizedHashSP800(PERSONALIZATION_FBE_KEY, PERSONALISATION_CONTEXT,
+	                                     synthetic_password.data(), synthetic_password.size());
+	OPENSSL_cleanse(synthetic_password.data(), synthetic_password.size());
+	return !secret_hex->empty();
+}
